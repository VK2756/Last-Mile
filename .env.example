# NEVER commit real values. Copy to .env.local (web) / engine/.env (engine). Share secrets via a password manager, not git.

# --- Lane C: data + AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MONGODB_URI=
MONGODB_DB=lastmile
TIGER_DATABASE_URL=

# --- Lane A: engine (Vultr) ---
PORT=8080
ENGINE_CORS_ORIGIN=https://YOUR-VERCEL-DOMAIN

# --- Lane B: web (Vercel) ---
NEXT_PUBLIC_ENGINE_URL=https://api.YOURDOMAIN.tech

# --- Phone demo: Mac service (secrets stay on Mac) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEMO_PHONE_NUMBERS=
PHONE_SHARED_SECRET=
PUBLIC_PHONE_URL=https://YOUR-TAILSCALE-NODE.ts.net:8443
ENGINE_URL=http://127.0.0.1:8080
GEMINI_LIVE_MODEL=
PHONE_PORT=8443

# --- Phone demo: Vercel (PHONE_SHARED_SECRET is server-side only) ---
PHONE_SERVICE_URL=https://YOUR-TAILSCALE-NODE.ts.net:8443
NEXT_PUBLIC_PHONE_DEMO=0
